@startuml backend
' The backend's modules and classes (Phase 5). A request passes the
' middleware, the route, the service and the repository; the database is
' prepared by Alembic migrations before the app serves.

skinparam packageStyle rectangle
hide empty members
allowmixing

package "backend.app" {
  package api {
    class "api.py" as App <<FastAPI app>> {
      GET /
      POST /todo
      GET /todo/{todo_id}
      PUT /todo/{todo_id}
      DELETE /todo/{todo_id}  (soft delete)
      GET /todo?limit&page
      --
      lifespan(): serves only a database at the latest revision
      require_json(): 415 for POST/PUT bodies that are not JSON
    }
    class BodyLimitMiddleware {
      max_bytes = 16384
      413 for larger bodies, chunked ones included
    }
    note right of BodyLimitMiddleware
      Middleware, outermost first:
      TrustedHostMiddleware, CORSMiddleware,
      BodyLimitMiddleware
    end note
  }

  class "settings.py" as Settings {
    host, port, reload
    trusted_hosts, cors_origins
    --
    load_settings(): from BASICTODO_* variables
  }

  class "factory.py" as Factory {
    create_todo_service(): ToDoService
  }

  class "main.py" as Main {
    init_database(), then uvicorn.run(settings)
  }

  package business_logic {
    class ToDoService {
      create_todo(payload): ToDoSchema
      get_todo(id): ToDoSchema
      update_todo(id, payload): ToDoSchema
      delete_todo(id): bool
      get_all_todos(limit, page): list[ToDoSchema]
      count_todos(): int
      mark_to_do_as_done(id): ToDoSchema
    }
    class ToDoEntryBuilder {
      build_from_create_schema(payload): ToDoEntryData
    }
    class ValidatorFactory
    class UUIDValidator
    class FieldValidator
    class InputSanitizer {
      validate(value): the value, stripped
    }
    class "decorators.py" as Decorators {
      handle_service_exceptions
      is_duplicate_id(IntegrityError)
    }
    class "exceptions.py" as Exceptions {
      ToDoAlreadyExistsError
      ToDoNotFoundError
      ToDoValidationError
      ToDoRepositoryError
    }
  }

  package data_access {
    class ToDoRepository {
      create_to_do(entry)
      get_to_do_entry(id)
      get_all_to_do_entries(limit, page)
      count_to_do_entries()
      update_to_do(id, data)
      delete_to_do(id): soft delete
      hard_delete_to_do(id)
    }
    class "database.py" as Database {
      DATABASE_URL
      engine
      safe_session_scope()
    }
    class "schema.py" as Schema {
      prepare_database(url): create, back up, stamp, upgrade
      assert_at_head(url)
      BASELINE_SCHEMA
    }
    class "database_file.py" as DatabaseFile {
      DEFAULT_DATABASE_PATH
      protect(engine, url): files 0600
    }
  }

  package models {
    class ToDoEntryData <<dataclass, table toDo>> {
      id: UUID
      title: str
      description: str | None
      created_at: datetime (UTC)
      updated_at: datetime (UTC)
      deleted: bool
      done: bool
    }
    class UTCDateTime <<column type>>
  }

  package schemas {
    class ToDoCreateScheme {
      id: UUID
      title: str
      description: str | None
    }
    class TodoUpdateScheme {
      title: str
      description: str | None
      done: bool
    }
    class ToDoSchema
    class "text_rules.py" as TextRules {
      clean_title(), clean_description()
    }
    class ApiResponse {
      success: bool
      data, message, error
    }
    class ToDoResponse {
      todo_entry: ToDoSchema
    }
    class GetToDoResponse {
      todo_entry: ToDoSchema
    }
    class ListToDoResponse {
      results: int
      total: int
      todo_entries: list[ToDoSchema]
    }
    class DeleteToDoResponse {
      message: str
    }
  }

  class "logger.py" as Logger {
    CustomLogger(name)
  }
}

package "backend.migrations" {
  class "env.py" as Env
  class "0001_baseline.py" as Rev1
  class "0002_utc_timestamps.py" as Rev2
  class "check_baseline.py" as CheckBaseline
}

package "backend.scripts" {
  class "init_db.py" as InitDb {
    init_database()
  }
}

database "SQLite file" as SQLite

BodyLimitMiddleware --> App
App --> ToDoService
App ..> Schema : lifespan
App ..> Settings
Factory --> ToDoService : creates
ToDoService --> ToDoEntryBuilder
ToDoService --> ToDoRepository
ToDoService --> InputSanitizer
ToDoService ..> Decorators
ToDoEntryBuilder --> UUIDValidator
ToDoEntryBuilder --> FieldValidator
ValidatorFactory ..> UUIDValidator : creates
ValidatorFactory ..> FieldValidator : creates
ValidatorFactory ..> InputSanitizer : creates
ToDoRepository --> Database : sessions
ToDoRepository --> ToDoEntryData
ToDoEntryData --> UTCDateTime
Database --> DatabaseFile
Schema --> DatabaseFile
Schema --> Env : runs
Env --> Rev1
Env --> Rev2
CheckBaseline --> Schema
Main --> InitDb
Main ..> Settings
InitDb --> Schema
ToDoCreateScheme ..> TextRules
TodoUpdateScheme ..> TextRules
ToDoResponse -u-|> ApiResponse
GetToDoResponse -u-|> ApiResponse
ListToDoResponse -u-|> ApiResponse
DeleteToDoResponse -u-|> ApiResponse
Database --> SQLite
Schema --> SQLite
@enduml
